{
  "name": "probe-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,agent -c green,cyan npm:dev:web npm:dev:agent",
    "dev:web": "vite",
    "dev:agent": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "setup": "playwright install chromium",
    "db:push": "drizzle-kit push"
  },
