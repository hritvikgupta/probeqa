    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "agentmail": "^0.5.3",
    "ai": "^6.0.177",
    "dodopayments": "^2.32.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "lucide-react": "^1.16.0",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
